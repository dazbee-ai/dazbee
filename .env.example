# Copy to .env (git-ignored) for docker compose. Sign-in with WorkOS (#58) is on when all three
# WORKOS_ settings are set; leave them empty to use the development session only.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
# The web app's /callback, registered as a redirect URI in the WorkOS dashboard.
WORKOS_REDIRECT_URI=
# At least 32 characters; a different one for every deployed server.
SESSION_SECRET=
# Early access: a comma-separated list of the emails allowed to sign up. When it or ADMIN_EMAILS names any,
# only they, admins, people who are already members and people accepting an invite get in.
ALLOWED_EMAILS=
# Early access's admins: a comma-separated list of the emails that use the admin page at PILOT_HOST, invite
# people to Dazbee and are always let in.
ADMIN_EMAILS=
# The secret of the Cloudflare Turnstile check on Request access; empty skips the check.
TURNSTILE_SECRET_KEY=
# Pixabay's API key, which turns agents' stock photo search on (search_stock and add_stock); empty leaves it off.
PIXABAY_API_KEY=
# The web app's setting, read from its own environment (apps/web/.env.local when it runs with next dev),
# not from this file: the address the sign-in page tells a person early access refused to write to.
SUPPORT_EMAIL=
# Also the web app's, from its own environment: the host the early-access admin page is served at, with its
# port for a local run (such as pilot.localhost:3000), and Turnstile's site key for Request access, which an
# empty key leaves without the check.
PILOT_HOST=
TURNSTILE_SITE_KEY=

# Caddy in front of the production stack: app.dazbee.com and pilot.dazbee.com (the early-access admin page)
# to the web app, app.dazbee.com's /mcp, /oauth/* and /.well-known/oauth-* to the MCP server (ADR-0019),
# a PUT to app.dazbee.com's /uploads/*, an agent's upload link (ADR-0010), to the API, sync.dazbee.com to the
# sync server, and http://caddy:8080, which only the containers reach, to the API.
# Ports 80 and 443 take connections from Cloudflare's addresses only (deploy/setup.sh), so the
# CF-Connecting-IP the MCP server counts sign-ins by comes from Cloudflare. Both public sites use
# Cloudflare's origin certificate, from the certs/ folder beside compose's .env, as origin.pem and
# origin.key.
#
# The web app and API go through the router (deploy/router.Caddyfile), which sends to their live
# colours and is reloaded at each swap. This Caddy is not: a reload drops the TLS handshakes in
# flight. It opens a connection to the router for each request, since a reload closes the ones kept
# open between requests.
{
	# Cloudflare's certificate is the only one Caddy serves, so it never asks a CA for one.
	auto_https disable_certs
	servers {
		protocols h1 h2
	}
}

# Sends to the router on a new connection each time, and waits a moment for a router that is starting.
# A request the router closed unanswered is sent again whatever its method: a reload of the router
# now and then closes a connection it has just accepted, before it reads the request, while one it
# has passed on is always answered, so no request reaches an app twice.
(router) {
	lb_try_duration 5s
	lb_retry_match {
		method GET HEAD POST PUT PATCH DELETE OPTIONS
	}
	transport http {
		keepalive off
	}
}

app.dazbee.com {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	@mcp path /mcp /oauth/* /.well-known/oauth-*
	handle @mcp {
		# Waits a moment for an MCP server that is restarting, as each deploy restarts it: a request that
		# never reached it is sent again, and of those that did, only a GET.
		reverse_proxy mcp:3100 {
			lb_try_duration 10s
		}
	}
	# A file sent to an upload link: its body at most the upload limit, MAX_UPLOAD_BYTES (30 MiB), streamed to the
	# API, which checks it again. It is never sent again, as its body is gone once sent; a link the API never saw
	# is still unused, so the agent sends the file again.
	@upload {
		method PUT
		path /uploads/*
	}
	handle @upload {
		request_body {
			max_size 30MiB
		}
		reverse_proxy router:8787 {
			transport http {
				keepalive off
			}
		}
	}
	handle {
		reverse_proxy router:3000 {
			import router
		}
	}
}

pilot.dazbee.com {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	reverse_proxy router:3000 {
		import router
	}
}

sync.dazbee.com {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
	reverse_proxy sync:1234 {
		# A reload keeps open designs' sockets for this long. Every deploy restarts the sync server,
		# which closes them sooner.
		stream_close_delay 24h
	}
}

http://caddy:8080 {
	reverse_proxy router:8787 {
		import router
	}
}

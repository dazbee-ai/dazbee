# The production .env, beside deploy/ (/opt/dazbee/.env on the server), which only root and the
# deploy user read. Every value stays empty here; the real ones are set on the server only.

# Postgres's password, which the API and sync server connect with; letters and digits only.
POSTGRES_PASSWORD=
# The key the API signs sync tokens with and the sync server checks them with; at least 32 characters.
SYNC_TOKEN_SECRET=
# The key the API signs session tokens with; at least 32 characters.
SESSION_SECRET=
# WorkOS Production's API key.
WORKOS_API_KEY=
# WorkOS Production's client ID.
WORKOS_CLIENT_ID=
# Where WorkOS sends a person back after sign-in: the web app's /callback.
WORKOS_REDIRECT_URI=
# The S3 address of the files bucket.
STORAGE_ENDPOINT=
# The files bucket's name.
STORAGE_BUCKET=
# The access key ID of the key limited to the files bucket.
STORAGE_ACCESS_KEY_ID=
# The secret of that key.
STORAGE_SECRET_ACCESS_KEY=
# The S3 address of the backups bucket, which deploy/backup.sh uploads each night's dump to.
R2_BACKUP_ENDPOINT=
# The backups bucket's name.
R2_BACKUP_BUCKET=
# The access key ID of the key limited to the backups bucket.
R2_BACKUP_ACCESS_KEY_ID=
# The secret of that key.
R2_BACKUP_SECRET_ACCESS_KEY=
# The API's early-access list: comma-separated emails that may sign up. With it and ADMIN_EMAILS both
# empty, anyone may sign up; either one set puts sign-up in early access.
ALLOWED_EMAILS=
# The API's early-access admins: comma-separated emails that use the admin page and are always let in.
ADMIN_EMAILS=
# The secret of the Cloudflare Turnstile widget on Request access, which the API checks tokens with.
TURNSTILE_SECRET_KEY=
# Pixabay's API key, which turns agents' stock photo search on; empty leaves it off.
PIXABAY_API_KEY=
# The web app's address people write to, which the early-access notice on /login names.
SUPPORT_EMAIL=
# The web app's host for the early-access admin page; pilot.dazbee.com when empty.
PILOT_HOST=
# The site key of the Cloudflare Turnstile widget on Request access; empty leaves the form without it.
TURNSTILE_SITE_KEY=

# Capacity limits, each a whole number; empty takes the default deploy/compose.yml names beside it, which
# is the app's own. An app refuses to start on a value out of its range.
# The MCP server: agent tabs open at once (30), and those one agent access may have open (1), past which an
# MCP session opening one takes over the access's oldest agent tab.
MCP_AGENT_TABS=
MCP_AGENT_TABS_PER_ACCESS=
# The MCP server: sessions in all (200), those one access may hold (4), and the minutes an unused one lives (30).
MCP_SESSIONS=
MCP_SESSIONS_PER_ACCESS=
MCP_SESSION_IDLE_MINUTES=
# The MCP server: each access's calls at once (60), then each second (2).
MCP_CALLS_BURST=
MCP_CALLS_PER_SECOND=
# The MCP server: each access's renders at once (10), then one every so many seconds (6); renders that may
# wait in the process (8).
MCP_RENDERS_BURST=
MCP_RENDER_EVERY_SECONDS=
MCP_RENDERS_WAITING=
# The MCP server: new designs one access may make in an hour (30).
MCP_DESIGNS_PER_HOUR=
# The sync server: design bytes held loaded at once, in MB (200); designs kept loaded with no tab (50), and
# for how many seconds (60).
SYNC_LOADED_MB=
SYNC_IDLE_DESIGNS=
SYNC_IDLE_SECONDS=
# The API: agents' sign-ins one address may start in an hour (60), and client registrations in all in an
# hour (500).
AGENT_SIGN_INS_PER_HOUR=
AGENT_REGISTRATIONS_PER_HOUR=
# The worker's OpenAI key, production's own, in an OpenAI project of production's own; empty skips OpenAI.
OPENAI_API_KEY=
# The worker's key for Meta's Model API (Muse Image), production's own; empty skips Meta.
MUSE_API_KEY=
# The worker's OpenRouter key, production's own; empty skips OpenRouter.
OPENROUTER_API_KEY=
# The worker's ZenMux key, production's own; empty skips ZenMux.
ZENMUX_API_KEY=
# The worker's Pixazo key, production's own; empty skips Pixazo.
PIXAZO_API_KEY=
